; ucrt_xp.def - explicit export ordinals.
;
; WHY THIS FILE EXISTS: without a .def file, exported ordinal numbers are
; assigned by the linker in whatever order it feels like, and can shift
; between builds even with zero source changes. Some old-style import
; libraries / manually-bound callers link by ordinal for speed. Pinning
; ordinals here means ucrt_xp.dll can be rebuilt (bug fixes, new
; functions appended at the end) without invalidating anything that
; happens to bind by ordinal instead of by name.
;
; RULE: never reuse or renumber an existing ordinal. New exports always
; get the next unused number.

LIBRARY ucrt_xp

EXPORTS
    ucrt_xp_init                  @1
    ucrt_xp_get_version           @2

    ucrt_xp_once                  @10

    ucrt_xp_cond_init             @20
    ucrt_xp_cond_destroy          @21
